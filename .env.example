# ─── Provider API keys (victim + guardrail models, used by the Docker backend) ──
# Set a key for every provider you put in APP_MODEL / GUARDRAIL_MODEL / eval/sweep.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY=          # for google-gla:gemini-* models

# ─── Model selection (overrides config/models.yaml; see that file) ─────
# Provider-qualified for the app roles; any role can be swapped independently.
APP_MODEL=anthropic:claude-haiku-4-5
GUARDRAIL_MODEL=anthropic:claude-haiku-4-5
# JUDGE_MODEL=            # empty => deterministic regex success-check (no model cost)
# The attack agent runs locally on the Claude Agent SDK + your Claude Code subscription
# (`claude` login); its model is ATTACK_MODEL / config/models.yaml (default claude-opus-5).

# ─── Spend caps for the attack agent + eval (USD per provider; see eval/budget.py) ──
# BUDGET_USD=anthropic=19,openai=19

# ─── Optional third-party guardrails ───────────────────────────────────
# Lakera Guard free tier (defense=lakera). If unset, that defense is skipped.
# LAKERA_API_KEY=
# Lakera detectors that block (default prompt_attack). Don't add pii/* — transcripts are
# full of email addresses, so it would block every upload.
# LAKERA_DETECTORS=prompt_attack
# Jev (TypeSafe AI) zero-shot classifier (defense=jev). If unset, that defense is skipped.
# Pricing isn't published, so Jev calls aren't counted in the budget ledger.
# TYPESAFE_API_KEY=
# JEV_THRESHOLD=0.5      # block if any injection question scores >= this probability
# Local LLM Guard classifier (defense=llm_guard) runs as its own container, started by
# `docker compose up` with the rest of the app. Tuning (optional):
# LLM_GUARD_MATCH_TYPE=CHUNKS   # CHUNKS scans the whole transcript; FULL truncates to 512 tokens
# LLM_GUARD_THRESHOLD=0.5

# ─── App config ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/tasksai
# REQUIRED — no insecure default. Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=
